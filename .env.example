# Server
PORT=3000

# MongoDB (TypeORM)
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/?appName=your_app
DATABASE_NAME=flux
# If Node fails to connect with "querySrv ECONNREFUSED" (some networks refuse
# Node's SRV lookups), use the equivalent direct URI instead, e.g.:
# DATABASE_URL=mongodb://user:password@shard-00-00.cluster.mongodb.net:27017,shard-00-01.cluster.mongodb.net:27017,shard-00-02.cluster.mongodb.net:27017/flux?replicaSet=<replicaset>&authSource=admin&tls=true

# Chatbot (OpenAI)
# Required for POST /api/v1/chatbot. Every request is billed to this key.
OPENAI_API_KEY=
# Chat model to use. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Per-request timeout in milliseconds. Defaults to 30000.
# OPENAI_TIMEOUT_MS=30000
# Override the API base URL (e.g. an Azure/proxy endpoint). Defaults to OpenAI.
# OPENAI_BASE_URL=
